<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/pref_category_voice">

        <SwitchPreferenceCompat
            app:key="voice_enabled"
            app:title="@string/pref_voice_title"
            app:summary="@string/pref_voice_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="captions_enabled"
            app:title="@string/pref_captions_title"
            app:summary="@string/pref_captions_summary"
            app:defaultValue="true" />

        <ListPreference
            app:key="avatar_outfit"
            app:title="@string/pref_outfit_title"
            app:entries="@array/avatar_outfit_entries"
            app:entryValues="@array/avatar_outfit_values"
            app:defaultValue="classic"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/pref_category_reminders">

        <SwitchPreferenceCompat
            app:key="reminders_enabled"
            app:title="@string/pref_reminders_title"
            app:summary="@string/pref_reminders_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="quiet_hours_enabled"
            app:title="@string/pref_quiet_hours_title"
            app:summary="@string/pref_quiet_hours_summary"
            app:defaultValue="true" />

        <Preference
            app:key="quiet_hours_start"
            app:title="@string/pref_quiet_hours_start_title"
            app:dependency="quiet_hours_enabled" />

        <Preference
            app:key="quiet_hours_end"
            app:title="@string/pref_quiet_hours_end_title"
            app:dependency="quiet_hours_enabled" />

    </PreferenceCategory>

</PreferenceScreen>
