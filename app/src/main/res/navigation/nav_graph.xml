<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_routines">

    <fragment
        android:id="@+id/nav_routines"
        android:name="edu.cnm.deepdive.paula.controller.RoutineFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_routine" />

    <fragment
        android:id="@+id/nav_tasks"
        android:name="edu.cnm.deepdive.paula.controller.TaskFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_task">

        <action
            android:id="@+id/action_tasks_to_task_edit"
            app:destination="@id/nav_task_edit" />

    </fragment>

    <fragment
        android:id="@+id/nav_voice_prompts"
        android:name="edu.cnm.deepdive.paula.controller.VoicePromptFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_voice_prompt" />

    <dialog
        android:id="@+id/nav_task_edit"
        android:name="edu.cnm.deepdive.paula.controller.TaskEditFragment"
        android:label="@string/title_task_edit"
        tools:layout="@layout/fragment_task_edit">

        <argument
            android:name="taskId"
            android:defaultValue="0L"
            app:argType="long" />

    </dialog>

    <fragment
        android:id="@+id/nav_settings"
        android:name="edu.cnm.deepdive.paula.controller.SettingsFragment"
        android:label="@string/title_settings" />

</navigation>
