<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/companion_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    tools:context="edu.cnm.deepdive.paula.controller.VoicePromptFragment">

    <!-- 1. Paula Avatar Video / Portrait Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/avatar_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.68"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/text_app_tagline"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/paula_avatar_purple_hoodie"
                android:contentDescription="@string/avatar_content_description" />

            <VideoView
                android:id="@+id/avatar_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 1b. App Tagline directly below Paula Avatar Card -->
    <TextView
        android:id="@+id/text_app_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/app_tagline"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold|italic"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/avatar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_speech_bubble" />

    <!-- 2. Speech Bubble & Affirmation Caption Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_speech_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:layout_constraintTop_toBottomOf="@id/text_app_tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_streak_status">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/icon_quote"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_voice_prompts"
                android:contentDescription="@string/quote_icon_content_description"
                app:tint="?attr/colorPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_speech_bubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/prompt_default_greeting"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/icon_quote"
                app:layout_constraintStart_toEndOf="@id/icon_quote"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/text_audio_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/prompt_audio_subtitle"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/text_speech_bubble"
                app:layout_constraintStart_toStartOf="@id/text_speech_bubble"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Habit Streak Celebration Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_streak_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:layout_constraintTop_toBottomOf="@id/card_speech_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_play_voice">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/icon_streak"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_local_fire"
                android:contentDescription="@string/streak_icon_content_description"
                app:tint="?attr/colorTertiary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_streak_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/streak_banner_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_streak"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/text_streak_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/streak_banner_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/text_streak_title"
                app:layout_constraintStart_toStartOf="@id/text_streak_title"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Interactive Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_play_voice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:text="@string/action_play_greeting"
        app:icon="@drawable/ic_play_arrow"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/card_streak_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_tutorial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_tutorial"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/action_watch_tutorial"
        app:icon="@drawable/ic_ondemand_video"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="@id/button_play_voice"
        app:layout_constraintBottom_toBottomOf="@id/button_play_voice"
        app:layout_constraintStart_toEndOf="@id/button_play_voice"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
